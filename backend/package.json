{
  "name": "casper-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon api/server.js",
    "start": "node api/server.js",
    "test": "node --test",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node database/seed.js",
    "worker": "node worker.js",
    "start:prod": "prisma db push --skip-generate && node database/seed.js && node start.js",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.js",
    "demo:record": "node scripts/record.js",
    "evaluate": "node scripts/evaluate.js",
    "db:seed:demo": "node scripts/seed-demo.js",
    "doctor": "node scripts/doctor.js",
    "diagnose": "node scripts/diagnose.js"
  },
  "prisma": {
    "schema": "database/schema.prisma"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cheerio": "^1.0.0",
    "chrono-node": "^2.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "globals": "^15.11.0"
  },
  "optionalDependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "^5.22.0"
  }
}
