# =====================================================================================
# CASPER demo settings.  Copy this file to  backend/.env  (nothing to paste: search runs locally, no key needed).
#   Windows:   copy .env.demo.example backend\.env
#   Mac/Linux: cp .env.demo.example backend/.env
# Never commit backend/.env, never paste it into chat or slides.
# =====================================================================================

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- Data: in memory, so no database is needed. Everything resets when the server stops;
#      the demo accounts and sample queries are recreated at every start. ----
DATA_STORE=memory
QUEUE=inline
CACHE=memory

# ---- Login secret. This one was generated for local demo use only. Make your own for anything else:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" ----
JWT_SECRET=c7c8e75e0a3dbd293a67d439725aef5cae755e9396fc09cb8cce1b37004c0eb0

# ---- Search. Providers are tried in order; any without a key / address is skipped, and if one fails the next is used.
#      FASTEST AND MOST RELIABLE: a free Serper key (serper.dev, no card): paste it after SERPER_API_KEY= below. It also
#      returns Google Shopping prices. Without a key CASPER falls back to SearXNG (a local search engine, needs Docker).
#      See docs/RUN_GUIDE.md, step 4. ----
SEARCH_PROVIDER=serper,tavily,searxng
SERPER_API_KEY=9a0517d61e43d2534c0599ecde9ff1da5774af3a
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=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
BRAVE_API_KEY=
SCRAPER_USER_AGENT=CASPERBot/1.0 (academic price-benchmarking project; contact: your-name@your-college.edu.in)
SCRAPE_MIN_INTERVAL_MS=1500

# ---- Demo accounts and sample data (created automatically at every start) ----
DEMO_SEED=true
DEMO_QUICK_LOGIN=true            # adds "Continue as administrator / government employee" buttons. Laptop only, never on a public server.
ADMIN_EMAIL=admin@demo.gov.in
ADMIN_PASSWORD=Admin@demo123
DEMO_OFFICER_EMAIL=officer@demo.gov.in
DEMO_OFFICER_PASSWORD=Officer@demo123

# ---- Sign-up rules for NEW accounts (the demo accounts above skip them) ----
REGISTRATION_EMAIL_DOMAIN=gov.in
REGISTRATION_CODE=               # optional: set an invite code that only you know

# ---- Safety net for the viva (see docs/Demo_Runbook.md): replay = answer from a saved recording, no internet ----
DEMO_MODE=

# ---- How results are found (see docs/RUN_GUIDE.md, "How searching works") ----
# true  (default): prices read from search listings and shopping data are shown even when the shop is not on the
#                  approved list; such rows are flagged "Unlisted source". Pages of unlisted shops are never fetched.
# false: only approved sources are used.
ALLOW_UNLISTED_SOURCES=true
SEARCH_COUNTRY=in               # country bias for Serper searches and Google Shopping prices

# ---- How wide a search goes ----
SEARCH_SITE_GROUPS=2             # searches over groups of approved sites per query (each group = 8 sites, 1 search request). 1 = cheaper, 3 = wider
MAX_RESULTS=40                   # most rows one search can return
